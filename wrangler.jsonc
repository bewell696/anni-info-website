{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anni-info-website",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": ".",
    "include": [
      "*.html",
      "styles/**"
    ],
    "exclude": [
      "node_modules/**",
      "*.md",
      "*.py",
      "*.sh",
      "*.json",
      "*.txt"
    ]
  }
}
